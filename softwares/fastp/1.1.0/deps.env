# fastp 依赖配置
# 需要: libdeflate, isa-l (Intel Storage Acceleration Library)

# Linux - 静态编译依赖
DEPS_APT="build-essential cmake nasm yasm zlib1g-dev"
NEED_RUSTUP="no"

# macOS - 使用 brew
DEPS_BREW="libdeflate nasm yasm"
NEED_RUSTUP="no"

# Windows (MSYS2) - 交叉编译
DEPS_MSYS2="base-devel cmake nasm yasm mingw-w64-x86_64-zlib"
NEED_RUSTUP="no"
