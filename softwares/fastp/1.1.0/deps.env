# fastp 依赖配置
# 需要: libdeflate, isa-l (Intel Storage Acceleration Library)
# 依赖: autoconf, automake, libtool, nasm (>=2.11.01), yasm (>=1.2.0)

# Linux - 静态编译依赖
DEPS_APT="build-essential cmake nasm yasm zlib1g-dev git autoconf automake libtool pkg-config help2man libdeflate-dev"
NEED_RUSTUP="no"

# macOS - brew
DEPS_BREW="libdeflate nasm yasm autoconf automake libtool help2man"
NEED_RUSTUP="no"

# Windows (MSYS2) - 交叉编译
DEPS_MSYS2="base-devel cmake nasm yasm mingw-w64-x86_64-zlib mingw-w64-x86_64-bzip2 mingw-w64-x86_64-xz mingw-w64-x86_64-libdeflate mingw-w64-x86_64-isa-l git autoconf automake libtool"
NEED_RUSTUP="no"
