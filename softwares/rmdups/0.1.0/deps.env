# Rust toolchain required for all platforms
# Linux - 需要 rustup 进行版本管理
DEPS_APT="build-essential curl"
RUSTUP_INSTALL="curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable"

# macOS - 需要 rustup
DEPS_BREW="curl"
RUSTUP_INSTALL="curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable"

# Windows (MSYS2)
DEPS_MSYS2="base-devel curl"
RUSTUP_INSTALL="curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable"
